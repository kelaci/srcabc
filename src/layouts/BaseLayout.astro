---
import SeoHead from "../components/SeoHead.astro";
import { Font } from "astro:assets";
import { siteMeta } from "../config/site";
import stylesUrl from "../styles/global.css?url";
import type { FaqItem, StructuredData } from "../types/site";
import { buildDefaultStructuredData } from "../utils/structuredData";

interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
  structuredData?: StructuredData[];
  faqItems?: FaqItem[];
  breadcrumbItems?: { name: string; url: string }[];
  canonical?: string;
  image?: string;
}

const {
  title = siteMeta.defaultPageTitle,
  description = siteMeta.description,
  noindex = false,
  structuredData,
  faqItems,
  breadcrumbItems,
  canonical,
  image,
} = Astro.props;

const resolvedStructuredData = noindex
  ? []
  : structuredData ?? buildDefaultStructuredData({
      description,
      faqItems,
      breadcrumbItems: breadcrumbItems ?? [
        { name: "Home", url: siteMeta.url },
      ],
    });
---

<!doctype html>
<html lang="en">
  <head>
    <meta content="width=device-width, initial-scale=1.0" name="viewport" />
    <SeoHead
      title={title}
      description={description}
      pathname={Astro.url.pathname}
      noindex={noindex}
      canonical={canonical}
      image={image}
    />
    <Font
      cssVariable="--font-inter"
      preload={[
        { weight: 400, subset: "latin" },
        { weight: 400, subset: "latin-ext" },
      ]}
    />
    <Font
      cssVariable="--font-dm-serif"
      preload={[
        { weight: 400, subset: "latin" },
        { weight: 400, subset: "latin-ext" },
      ]}
    />
    <Font cssVariable="--font-jetbrains-mono" />
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
    {
      resolvedStructuredData.map((schema) => (
        <script type="application/ld+json" set:html={JSON.stringify(schema).replace(/</g, '\\u003c')} is:inline />
      ))
    }
    <link rel="stylesheet" href={stylesUrl} />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div id="top"></div>
    <slot />
    <aside
      class="cookie-notice"
      data-cookie-notice
      role="region"
      aria-label="Privacy notice"
      hidden
    >
      <p class="cookie-notice__text">
        This site uses cookie-free, privacy-friendly visitor analytics
        (Cloudflare Web Analytics). We don't store cookies and we don't track
        personal data.
        <a class="cookie-notice__link" href="/privacy">Details</a>
      </p>
      <button type="button" class="cookie-notice__accept" data-cookie-accept>
        Got it
      </button>
    </aside>
    <!-- Cloudflare Web Analytics -->
    <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon='{"token": "ccf97cf4d9af41058159e67984c8ac3d"}' is:inline></script>
    <!-- End Cloudflare Web Analytics -->
    <script src="/scripts/site.client.js" type="module" is:inline></script>
  </body>
</html>
