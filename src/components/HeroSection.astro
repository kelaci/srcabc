---
import type { HeroContent } from "../types/site";

interface Props {
  content: HeroContent;
}

const { content } = Astro.props;

const icons: Record<HeroContent["coreCards"][number]["icon"], string> = {
  search:
    '<circle cx="11" cy="11" r="8"></circle><path d="m21 21-4.35-4.35"></path><path d="M11 8v6"></path><path d="M8 11h6"></path>',
  play: '<polygon points="5 3 19 12 5 21 5 3"></polygon>',
  grid: '<rect x="3" y="3" width="7" height="7"></rect><rect x="14" y="3" width="7" height="7"></rect><rect x="3" y="14" width="7" height="7"></rect><rect x="14" y="14" width="7" height="7"></rect>',
  check: '<polyline points="20 6 9 17 4 12"></polyline>',
};
---

<section class="hero">
  <div class="container hero-grid">
    <div class="hero-copy reveal">
      <span class="eyebrow"
        ><span class="dot"></span><span class="eyebrow-text">{content.eyebrow}</span></span
      >
      <h1>
        {content.titleLead}
        {content.titleAccent && <span class="accent">{content.titleAccent}</span>}
      </h1>
      <p class="lead">{content.intro}</p>

      <div class="hero-actions">
        <a class="button" href={content.primaryAction.href}>{content.primaryAction.label}</a>
        <a class="button-ghost" href={content.secondaryAction.href}>{content.secondaryAction.label}</a>
      </div>

      <div class="signal-strip">
        <strong>{content.signalLabel}</strong>
        <div class="signal-list">
          {
            content.signalItems.map((item) => (
              <span class="pill">{item}</span>
            ))
          }
        </div>
      </div>

      <div class="hero-proof">
        {
          content.metrics.map((metric) => (
            <div class="metric">
              <div class="label">{metric.label}</div>
              <strong>{metric.title}</strong>
              <p>{metric.description}</p>
            </div>
          ))
        }
      </div>
    </div>

    <aside class="hero-panel reveal">
      <div class="hero-panel-top">
        {
          content.statusChips.map((status, index) => (
            <span class="status-chip">
              {index === 0 && <span class="mini-dot"></span>}
              {status}
            </span>
          ))
        }
      </div>

      <div>
        <div class="micro-label">{content.panelLabel}</div>
        <h2 class="hero-panel-title">{content.panelTitle}</h2>
        {content.panelKicker && <p class="hero-panel-kicker">{content.panelKicker}</p>}
        <p class="hero-panel-copy">{content.panelCopy}</p>
      </div>

      <div class="hero-stack">
        {
          content.coreCards.map((card) => (
            <article class="stack-card">
              <div class="stack-icon">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="1.8"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  set:html={icons[card.icon]}
                />
              </div>
              <strong>{card.title}</strong>
              <div class="stack-subtitle">{card.subtitle}</div>
              <p>{card.description}</p>
            </article>
          ))
        }
      </div>

      <div class="panel-note">
        <strong>Ideal case:</strong> {content.panelNote}
      </div>
    </aside>
  </div>
</section>
