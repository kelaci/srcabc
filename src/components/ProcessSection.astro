---
import SectionIntro from "./common/SectionIntro.astro";
import type { ProcessSectionContent, ProcessPhase } from "../types/site";

interface Props {
  content: ProcessSectionContent;
}

const { content } = Astro.props;

const phases: ProcessPhase[] = ["research", "proto", "arch", "build"];
const checkIcon = '<polyline points="20 6 9 17 4 12"></polyline>';
const clockIcon =
  '<circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline>';
---

<section id="process">
  <div class="container">
    <SectionIntro
      eyebrow={content.eyebrow}
      title={content.title}
      description={content.description}
    />

    <div class="timeline">
      {
        content.steps.map((step, index) => {
          const phase = phases[index] ?? "research";
          const phaseStyle = `--phase-color: var(--phase-${phase}); --phase-color-glow: var(--phase-${phase}-glow); --stagger-delay: ${index * 140}ms; transition-delay: var(--stagger-delay);`;
          return (
            <article class="timeline-item reveal" style={phaseStyle}>
              <span class="timeline-dot" aria-hidden="true" />
              <div class="timeline-card">
                <div class="timeline-index">{step.index}</div>
                <div class="timeline-card-body">
                  <div class="micro-label">{step.label}</div>
                  <h3>{step.title}</h3>
                  <p>{step.description}</p>
                  <div class="timeline-specs">
                    <span class="timeline-spec">
                      <span class="timeline-spec-icon">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={checkIcon} />
                      </span>
                      {step.deliverable}
                    </span>
                    <span class="timeline-spec">
                      <span class="timeline-spec-icon">
                        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" set:html={clockIcon} />
                      </span>
                      {step.duration}
                    </span>
                  </div>
                  <ul class="bullet-list">
                    {step.bullets.map((bullet) => <li>{bullet}</li>)}
                  </ul>
                </div>
              </div>
            </article>
          );
        })
      }
    </div>
  </div>
</section>

<style>
  .timeline {
    position: relative;
    padding: 24px 0 8px;
  }

  .timeline::before {
    content: "";
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: 2px;
    transform: translateX(-50%);
    opacity: 0.6;
    background: linear-gradient(
      180deg,
      var(--phase-research) 0%,
      var(--phase-research) 20%,
      var(--phase-proto) 30%,
      var(--phase-proto) 45%,
      var(--phase-arch) 55%,
      var(--phase-arch) 72%,
      var(--phase-build) 78%,
      var(--phase-build) 100%
    );
  }

  .timeline-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    width: calc(50% - 40px);
    margin-bottom: 20px;
  }

  .timeline-item:last-child {
    margin-bottom: 0;
  }

  .timeline-item:nth-child(odd) {
    margin-right: auto;
  }

  .timeline-item:nth-child(even) {
    margin-left: auto;
  }

  .timeline-item::before {
    content: "";
    position: absolute;
    top: 32px;
    width: 24px;
    height: 2px;
    background: var(--phase-color);
    opacity: 0.5;
    transition: opacity 0.24s ease, transform 0.24s ease;
  }

  .timeline-item:nth-child(odd)::before {
    right: -20px;
  }

  .timeline-item:nth-child(even)::before {
    left: -20px;
  }

  .timeline-dot {
    position: absolute;
    top: 28px;
    left: 50%;
    z-index: 2;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    background: var(--phase-color);
    box-shadow: 0 0 20px var(--phase-color-glow);
    transform: translateX(-50%);
    transition: box-shadow 0.24s ease, transform 0.24s ease;
  }

  .timeline-dot::after {
    content: "";
    position: absolute;
    inset: -6px;
    border-radius: 50%;
    background: var(--phase-color-glow);
    opacity: 0;
    transition: opacity 0.34s ease;
  }

  .timeline-card {
    position: relative;
    flex: 1;
    min-width: 0;
    overflow: hidden;
    padding: 22px 22px 24px;
    border: 1px solid var(--line);
    border-left: 3px solid var(--phase-color);
    border-radius: var(--radius);
    background: var(--panel);
    box-shadow: var(--shadow);
    backdrop-filter: blur(16px);
    transition: transform 0.24s ease, border-color 0.24s ease, box-shadow 0.24s ease;
  }

  .timeline-card:hover {
    border-color: rgba(183, 196, 255, 0.28);
    transform: translateY(-3px);
    box-shadow: 0 28px 70px rgba(0, 0, 0, 0.46);
  }

  .timeline-item:hover::before {
    opacity: 1;
    transform: scaleX(1.15);
  }

  .timeline-item:hover .timeline-dot {
    box-shadow: 0 0 32px var(--phase-color-glow);
    transform: translateX(-50%) scale(1.2);
  }

  .timeline-item:hover .timeline-dot::after {
    opacity: 0.6;
  }

  .timeline-index {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    margin-bottom: 14px;
    border-radius: 12px;
    background: var(--phase-color);
    color: #07111f;
    font: 800 0.9rem/1 JetBrains Mono, monospace;
    transition: transform 0.2s ease;
  }

  .timeline-card:hover .timeline-index {
    transform: scale(1.08);
  }

  .timeline-card h3 {
    margin: 8px 0 6px;
    color: var(--text);
    font-size: clamp(1.15rem, 2vw, 1.45rem);
    line-height: 1;
  }

  .timeline-card-body p {
    margin: 0 0 12px;
    color: var(--muted);
    font-size: 0.96rem;
    text-align: justify;
  }

  .timeline-specs {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-bottom: 14px;
  }

  .timeline-spec {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    color: var(--soft);
    font: 500 0.78rem/1.25 JetBrains Mono, monospace;
    letter-spacing: 0.02em;
  }

  .timeline-spec-icon {
    display: inline-flex;
    flex: 0 0 auto;
    width: 12px;
    height: 12px;
    color: var(--phase-color);
  }

  :global(.js) .timeline-item.reveal {
    opacity: 0;
    transform: translateY(24px);
    transition:
      opacity 0.5s cubic-bezier(0.22, 1, 0.36, 1),
      transform 0.5s cubic-bezier(0.22, 1, 0.36, 1);
  }

  :global(.js) .timeline-item.reveal.in-view {
    opacity: 1;
    transform: translateY(0);
  }

  @media (max-width: 1120px) {
    .timeline-item {
      width: calc(50% - 28px);
    }
    .timeline-item::before {
      width: 16px;
    }
    .timeline-item:nth-child(odd)::before {
      right: -12px;
    }
    .timeline-item:nth-child(even)::before {
      left: -12px;
    }
  }

  @media (max-width: 820px) {
    .timeline::before {
      left: 24px;
    }
    .timeline-item {
      width: 100%;
      padding-left: 56px;
      margin-left: 0 !important;
      margin-right: 0 !important;
    }
    .timeline-item::before {
      top: 28px;
      left: 36px !important;
      right: auto !important;
      width: 20px;
    }
    .timeline-dot {
      left: 24px;
      transform: translateX(-50%);
    }
  }

  @media (max-width: 580px) {
    .timeline-item {
      padding-left: 44px;
    }
    .timeline-item::before {
      left: 28px !important;
      width: 16px;
    }
    .timeline-dot {
      top: 30px;
      left: 24px;
      width: 14px;
      height: 14px;
    }
    .timeline-card {
      padding: 18px;
      border-radius: 20px;
    }
    .timeline-index {
      width: 36px;
      height: 36px;
      font-size: 0.82rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.js) .timeline-item.reveal,
    :global(.js) .timeline-item.reveal.in-view {
      opacity: 1;
      transform: none;
      transition: none;
    }
  }
</style>
