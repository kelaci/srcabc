---
import type { ContactSectionContent } from "../types/site";

interface Props {
  content: ContactSectionContent;
}

const { content } = Astro.props;
---

<section id="contact">
  <div class="container">
    <div class="cta-shell reveal">
      <div>
        <span class="eyebrow"><span class="dot"></span><span class="eyebrow-text">{content.eyebrow}</span></span>
        <h2>{content.title}</h2>
        <p>{content.description}</p>
        <div class="contact-meta">
          {
            content.pills.map((pill) => (
              <span class="pill">{pill}</span>
            ))
          }
        </div>
      </div>

      <div class="contact-side">
        <div class="contact-form-card">
          <div class="contact-person">
            <img
              alt={content.person.photoAlt}
              decoding="async"
              height="256"
              loading="lazy"
              src={content.person.photo}
              width="256"
            />
            <div>
              <strong>{content.person.name}</strong>
              <a href={content.person.email.href}>{content.person.email.label}</a>
              <a href={content.person.phone.href}>{content.person.phone.label}</a>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
